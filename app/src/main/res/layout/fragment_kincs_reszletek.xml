<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/reszletNev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:text="Kincs neve"
            android:layout_marginBottom="8dp"/>

        <!-- ViewPager2 a több kép lapozásához -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerKepek"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginBottom="8dp"
            android:background="#DDDDDD" />

        <!-- Kép számláló indikátor (opcionális) -->
        <TextView
            android:id="@+id/tvKepSzamlalo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1/1"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/reszletFelfedezo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Felfedező: ..."
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/reszletLeiras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:text="Leírás..."
            android:layout_marginBottom="16dp"
            android:textColor="#333333"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvAtlagErtekeles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Értékelés: 0.0"
            android:textStyle="bold"/>

        <RatingBar
            android:id="@+id/ratingBarAtlag"
            style="?android:attr/ratingBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:rating="0"
            android:isIndicator="true"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvRatePrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rate_this"
            android:layout_marginBottom="4dp"/>

        <RatingBar
            android:id="@+id/ratingBarUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="1.0"
            android:rating="0"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/visszaGomb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/button_back_to_map"
            android:layout_marginTop="16dp"/>

        <Button
            android:id="@+id/torlesGomb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/button_delete_treasure"
            android:backgroundTint="#FF5252"
            android:textColor="@android:color/white" />

    </LinearLayout>
</ScrollView>